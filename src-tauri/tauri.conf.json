{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Issue Pilot",
  "version": "0.1.0",
  "identifier": "com.issuepilot.desktop",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:1421", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Issue Pilot", "width": 1200, "height": 780, "minWidth": 900, "minHeight": 600 }], "security": { "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:1421; connect-src 'self' http: https: ws://127.0.0.1:1421; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:" } },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
